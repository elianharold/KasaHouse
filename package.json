{
  "name": "kasahouse",
  "version": "0.1.0",
  "private": true,
  "description": "KasaHouse — direct landlord/seller-to-tenant/buyer property marketplace for Ghana",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "build:types": "pnpm --filter @kasahouse/shared-types build",
    "dev:backend": "pnpm --filter @kasahouse/backend start:dev",
    "dev:mobile": "pnpm --filter @kasahouse/mobile start",
    "dev:web": "pnpm --filter @kasahouse/web dev",
    "build:web": "pnpm --filter @kasahouse/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "prisma:generate": "pnpm --filter @kasahouse/backend prisma:generate",
    "prisma:migrate": "pnpm --filter @kasahouse/backend prisma:migrate",
    "db:seed": "pnpm --filter @kasahouse/backend db:seed"
  },
  "devDependencies": {
    "typescript": "5.9.2"
  }
}
