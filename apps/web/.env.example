# The NestJS API base URL (must include /api/v1).
# Local dev: point at the local backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Public site URL — used for absolute OG/canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# In production (Vercel), set:
#   NEXT_PUBLIC_API_BASE_URL = https://<your-railway-app>.up.railway.app/api/v1
#   NEXT_PUBLIC_SITE_URL     = https://<your-vercel-domain>
