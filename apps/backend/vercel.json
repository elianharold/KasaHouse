{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile --filter @kasahouse/backend...",
  "buildCommand": "pnpm --filter @kasahouse/backend run vercel-build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "memory": 512
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
