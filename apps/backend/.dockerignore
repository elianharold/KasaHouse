# This file applies when the build context is the repo root.
**/node_modules
**/dist
**/.expo
**/.expo-shared
**/web-build
**/*.tsbuildinfo

# never bake secrets into an image
**/.env
**/.env.*
!**/.env.example

# the client apps are not part of the API image (their manifests are copied
# explicitly by the Dockerfile for lockfile validation)
apps/mobile/src
apps/mobile/app
apps/mobile/assets
apps/web/src
apps/web/public

# vcs / editor / ci
.git
.github
.idea
.vscode
**/*.log

# docs & local-only
*.md
!README.md
