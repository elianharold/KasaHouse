# ─────────────────────────────────────────────────────────────
# KasaHouse API — Phase 1 environment
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
# Comma-separated origins allowed to call the API (Expo dev client, Next.js web).
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

# ── Database ────────────────────────────────────────────────
# Engine must be PostgreSQL (not SQLite).
#
# Option A — Neon (matches the names Vercel's Neon integration injects):
#   DATABASE_URL          = the "Pooled connection" string  (host contains "-pooler")
#   DATABASE_URL_UNPOOLED = the "Direct connection" string   (host without "-pooler")
#   Both end with ?sslmode=require
#
# Option B — local Postgres: set both to the same value, e.g.
#   postgresql://postgres:postgres@localhost:5432/kasahouse?schema=public
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/kasahouse?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/kasahouse?sslmode=require

# ── Auth / JWT ─────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-access
JWT_REFRESH_SECRET=replace-me-refresh
JWT_ACCESS_TTL=900          # seconds (15 min)
JWT_REFRESH_TTL=2592000     # seconds (30 days)

# ── OTP ────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_TTL_SECONDS=300         # code valid for 5 minutes
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_VERIFY_ATTEMPTS=5

# ── SMS provider ───────────────────────────────────────────
# console  -> logs the OTP to the server console, returns it in the API (DEV ONLY)
# africastalking -> real delivery via Africa's Talking
SMS_PROVIDER=console
# Africa's Talking. For the sandbox the username is ALWAYS "sandbox".
AT_USERNAME=sandbox
AT_API_KEY=
# Registered sender id / shortcode. Leave blank in sandbox.
AT_SENDER_ID=
# sandbox | production
AT_ENV=sandbox

# ── Email provider (sign-in codes) ─────────────────────────
# console -> logs the code + returns it in the API (DEV ONLY)
# resend  -> real delivery via Resend (https://resend.com)
EMAIL_PROVIDER=console
RESEND_API_KEY=
# The "from" address. In production this domain must be verified in Resend.
# "onboarding@resend.dev" works for testing only.
EMAIL_FROM=KasaHouse <onboarding@resend.dev>

# ── KYC (Ghana Card verification) ──────────────────────────
# console -> auto-decides submissions (rejects an ID number ending in "00")
# smileid -> real checks via Smile ID (not implemented yet)
KYC_PROVIDER=console
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=
SMILE_ID_ENV=sandbox
SMILE_ID_CALLBACK_URL=

# Minimum length for a user-set password.
AUTH_MIN_PASSWORD_LENGTH=8

# ── Cloudinary (media) ─────────────────────────────────────
# Media is uploaded directly from the device with a signed signature the API
# generates; the API never proxies file bytes.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Named eager transformation applied on upload (compress + generate thumb).
CLOUDINARY_IMAGE_PRESET=kasahouse_listing_image
CLOUDINARY_VIDEO_PRESET=kasahouse_listing_video

# ── Sentry (optional in Phase 1) ───────────────────────────
SENTRY_DSN=
