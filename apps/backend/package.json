{
  "name": "@kasahouse/backend",
  "version": "0.1.0",
  "private": true,
  "description": "KasaHouse API — NestJS (controller → service → repository)",
  "main": "dist/main.js",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && nest build",
    "vercel-build": "prisma migrate deploy && prisma generate && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@kasahouse/shared-types": "workspace:*",
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "11.2.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/throttler": "6.4.0",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "express": "^5.1.0",
    "pg": "^8.13.3",
    "africastalking": "^0.8.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.11.0",
    "helmet": "^8.3.0",
    "libphonenumber-js": "^1.13.12",
    "nanoid": "^3.3.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.10",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.10",
    "prisma": "6.19.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.2"
  }
}
