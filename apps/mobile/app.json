{
  "expo": {
    "name": "KasaHouse",
    "slug": "kasahouse",
    "scheme": "kasahouse",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kasahouse.app"
    },
    "android": {
      "package": "com.kasahouse.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B7A4B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B7A4B"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "KasaHouse needs access to your photos so you can add pictures and videos of your property.",
          "cameraPermission": "KasaHouse needs your camera so you can take pictures of your property."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "http://localhost:4000/api/v1"
    }
  }
}
