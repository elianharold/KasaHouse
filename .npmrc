# These are read by every pnpm version. pnpm 10+ also reads the equivalents
# from pnpm-workspace.yaml (nodeLinker / dedupePeerDependents); keeping both
# means the repo installs the same way on pnpm 9 (Vercel's built-in) and
# pnpm 12 (local / Railway Docker).
node-linker=hoisted
dedupe-peer-dependents=false
enable-pre-post-scripts=true
